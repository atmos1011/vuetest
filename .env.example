# Copy to .env.local and point it at the backend.
#
# This is the API GATEWAY, not one of the individual services. The gateway is
# the only address the frontend needs; it routes to PollManage, VoteManage and
# ResultManage behind the scenes.
#
# Local (all four backend projects running):
VITE_API_BASE_URL=http://localhost:5000/api

# Deployed (set this one in Vercel > Settings > Environment Variables):
# VITE_API_BASE_URL=https://pollbuilder-gateway-rj0d.onrender.com/api

# The SignalR hub sits at the gateway root, so it is derived by stripping /api
# off the URL above. Only set this if that ever stops being true.
# VITE_HUB_BASE_URL=http://localhost:5000
